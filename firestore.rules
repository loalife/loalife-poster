rules_version = '2';

// ============================================================================
// データ永続性ルール（生活インフラ）— 編集時の必読事項
//  - フィールドを厳格に検証する hasOnly() 等は安易に足さないこと。
//    新旧バージョンのドキュメントが混在するため、未知フィールド（version 含む）を
//    拒否すると、アップデート直後の既存ユーザーの書き込みが壊れる。
//  - 破壊的なルール変更（既存データの読み取り/更新を不能にする変更）は禁止。
//    スキーマ移行はアプリ側の schema.js（lazy migration）で吸収する方針。
//
//  セキュリティ不変条件（2026 監査対応・非破壊で追加）:
//   1. households の ownerUid / inviteCode は作成後に変更不可（乗っ取り・コード差し替え防止）。
//   2. 非オーナーは memberUids を「自分の uid の追加（参加）/削除（退出）」のみ変更可能。
//      他メンバーの追加・削除はオーナーのみ（締め出し防止）。
//   3. 参加（自分の追加）は招待コードの知識を証明（joinProof == inviteCode）した場合のみ。
//      → household ID を推測しても、コードを知らなければ参加できない（BOLA 防止）。
//   4. inviteCodes は list（列挙）禁止・get のみ許可（コード総なめ防止）。
//   5. 家族の新規作成・参加・招待コード作成はメール確認済み（または Google）ユーザーのみ。
//      ※ 退出と、既存メンバーによる自分のデータ更新は従来どおり（ロックアウト防止）。
//  変更時は Firebase エミュレータで「作成→参加→退出」と既存データ更新の回帰を必ず確認すること。
//
//  追加（2026-11-26・残りのギャップバッチ）— 上記5条件は不変のまま:
//   6. シッター期間限定共有: sitterGrants/{code}（get のみ・list 禁止・作成は確認済み
//      本人・削除＝失効は作成者のみ）。シッターは memberUids には入らず、世帯ドキュメントの
//      sitters マップ（uid→{memberIds, canWrite, expiresAt}）で管理する。参加は
//      グラント文書の内容と一致する自分のエントリ追加のみ許可（コード証明相当）。
//      読み取り・書き込みは全て expiresAt > request.time をルール側で強制するため、
//      期限切れ・失効後はクライアントの状態にかかわらずアクセスできない。
//   7. 家族ノート: households/{hid}/notes（世帯メンバーのみ読み書き、削除は本人/オーナー）。
//   8. memberProfiles: 参加者表示名は「自分のエントリだけ」を差分で制限して更新可
//      （memberUids / ownerUid / inviteCode は変更不可のまま）。
// ============================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // メール確認済み、または Google ログイン（Google は常に確認済み扱い）
    function verified() {
      return request.auth != null && (
        request.auth.token.email_verified == true ||
        request.auth.token.firebase.sign_in_provider == 'google.com'
      );
    }

    // Helper: check if user is in a household
    function isMember(hid) {
      return request.auth != null &&
        request.auth.uid in get(/databases/$(database)/documents/households/$(hid)).data.memberUids;
    }

    // Helper: 世帯オーナーの uid（破壊的操作の権限判定用）
    function householdOwnerUid(hid) {
      return get(/databases/$(database)/documents/households/$(hid)).data.ownerUid;
    }

    // Helper: check if member is visible to current user
    // ※ items の読み取り専用（memberId はパスパラメータ＝クエリに対して固定のドキュメントを
    //   引くため、クエリでも評価できる）。members 本体の読み取りでは使わないこと：
    //   対象ドキュメント自身を get() する形はコレクションクエリで「証明」できず、
    //   全件否認になる（members 側は resource.data で判定する）。
    function memberVisible(hid, memberId) {
      let m = get(/databases/$(database)/documents/households/$(hid)/members/$(memberId)).data;
      return m.visibility == "household" || m.ownerUid == request.auth.uid;
    }

    // 参加：自分の uid を1つだけ追加し、他メンバーは不変。招待コードの知識を証明すること。
    function isSelfJoin(before, req) {
      return !(req.auth.uid in before.data.memberUids)
        && (req.auth.uid in req.resource.data.memberUids)
        && req.resource.data.memberUids.hasAll(before.data.memberUids)
        && req.resource.data.memberUids.size() == before.data.memberUids.size() + 1
        && req.resource.data.joinProof == before.data.inviteCode;
    }

    // 退出：自分の uid を1つだけ削除し、他メンバーは不変。
    function isSelfLeave(before, req) {
      return (req.auth.uid in before.data.memberUids)
        && !(req.auth.uid in req.resource.data.memberUids)
        && before.data.memberUids.hasAll(req.resource.data.memberUids)
        && req.resource.data.memberUids.size() == before.data.memberUids.size() - 1;
    }

    // ─── シッター（期間限定共有）ヘルパー ─────────────────────────
    // 世帯ドキュメントのデータに対して、自分のシッターエントリが有効期限内か。
    function sitterActiveIn(data) {
      return request.auth != null
        && ('sitters' in data)
        && (request.auth.uid in data.sitters)
        && data.sitters[request.auth.uid].expiresAt is timestamp
        && data.sitters[request.auth.uid].expiresAt > request.time;
    }

    // サブコレクション用：世帯ドキュメントを get して判定する。
    function isActiveSitter(hid) {
      return sitterActiveIn(get(/databases/$(database)/documents/households/$(hid)).data);
    }

    // シッターがそのメンバーを見られるか（期限内＋対象メンバーに含まれる）。
    function sitterCanSeeMember(hid, memberId) {
      let h = get(/databases/$(database)/documents/households/$(hid)).data;
      return sitterActiveIn(h)
        && ('memberIds' in h.sitters[request.auth.uid])
        && memberId in h.sitters[request.auth.uid].memberIds;
    }

    // シッターが記録もできるか（canWrite）。
    function sitterCanWrite(hid) {
      let h = get(/databases/$(database)/documents/households/$(hid)).data;
      return sitterActiveIn(h) && h.sitters[request.auth.uid].canWrite == true;
    }

    // シッター参加：memberUids は不変のまま、sitterUids と sitters に自分のエントリを
    // 1つだけ追加する。エントリ内容は sitterGrants のグラント文書（世帯オーナー作成・
    // 未期限）と完全一致すること（グラントの改ざん・他世帯への流用を防ぐ）。
    function isSitterSelfJoin(hid, before, req) {
      let hasProof = ('sitterProof' in req.resource.data) && req.resource.data.sitterProof is string;
      let g = hasProof ? get(/databases/$(database)/documents/sitterGrants/$(req.resource.data.sitterProof)).data : {};
      let bs = ('sitters' in before.data) ? before.data.sitters : {};
      let bu = ('sitterUids' in before.data) ? before.data.sitterUids : [];
      return hasProof
        && ('householdId' in g) && g.householdId == hid
        && g.ownerUid == before.data.ownerUid
        && g.expiresAt is timestamp && g.expiresAt > request.time
        && req.resource.data.memberUids == before.data.memberUids
        && !(request.auth.uid in bu)
        && (request.auth.uid in req.resource.data.sitterUids)
        && req.resource.data.sitterUids.hasAll(bu)
        && req.resource.data.sitterUids.size() == bu.size() + 1
        && ('sitters' in req.resource.data)
        && req.resource.data.sitters.diff(bs).affectedKeys().hasOnly([request.auth.uid])
        && (request.auth.uid in req.resource.data.sitters)
        && req.resource.data.sitters[request.auth.uid].memberIds == g.memberIds
        && req.resource.data.sitters[request.auth.uid].canWrite == g.canWrite
        && req.resource.data.sitters[request.auth.uid].expiresAt == g.expiresAt;
    }

    // シッター退出：memberUids は不変のまま、自分のエントリだけを外す（確認要件なし＝
    // ロックアウト防止。通常退出と同じ扱い）。
    function isSitterSelfLeave(before, req) {
      let bs = ('sitters' in before.data) ? before.data.sitters : {};
      let bu = ('sitterUids' in before.data) ? before.data.sitterUids : [];
      return (request.auth.uid in bu)
        && req.resource.data.memberUids == before.data.memberUids
        && !(request.auth.uid in req.resource.data.sitterUids)
        && bu.hasAll(req.resource.data.sitterUids)
        && req.resource.data.sitterUids.size() == bu.size() - 1
        && (request.auth.uid in bs)
        && req.resource.data.sitters.diff(bs).affectedKeys().hasOnly([request.auth.uid])
        && !(request.auth.uid in req.resource.data.sitters);
    }

    // 参加者プロフィール（表示名・メール）の自己更新：変更できるのは memberProfiles の
    // 自分のエントリだけ。他の全フィールド（memberUids 含む）は差分ゼロを強制する。
    function isProfileSelfUpdate(before, req) {
      let bp = ('memberProfiles' in before.data) ? before.data.memberProfiles : {};
      return (request.auth.uid in before.data.memberUids)
        && ('memberProfiles' in req.resource.data)
        && req.resource.data.diff(before.data).affectedKeys().hasOnly(['memberProfiles'])
        && req.resource.data.memberProfiles.diff(bp).affectedKeys().hasOnly([request.auth.uid]);
    }

    // ─── User profiles ───────────────────────────────────────────
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      // "Me" items — always private, only owner can access
      match /meItems/{itemId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      // クラウドバックアップ（自分のデータの控え・オプトイン）。本人のみ読み書き可。
      // 家族共有とは別物で、世帯メンバーにも読めない。
      match /backup/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // ─── Invite codes (lookup table for joining) ──────────────────
    match /inviteCodes/{code} {
      // get のみ（参加時のコード→household 解決）。list（列挙）は禁止。
      allow get: if request.auth != null;
      allow list: if false;
      // 作成は確認済みユーザーのみ（householdId を含むこと）。
      allow create: if verified() &&
        request.resource.data.householdId is string;
      // 更新/削除はクライアントから不可（将来の失効はサーバー側で）。
      allow update, delete: if false;
    }

    // ─── Sitter grants （シッター期間限定共有の招待） ──────────────
    // 家族共有とは別の、期間限定・対象メンバー限定・権限つきの招待コード。
    // inviteCodes と同じ規律：get のみ（参加時の解決用）・list（列挙）禁止。
    // 作成は確認済みユーザーが自分の ownerUid のものだけ（期限は timestamp 必須・未来）。
    // 更新は不可。削除（＝失効）は作成者のみ。
    // 参加の実体は households 側の isSitterSelfJoin がグラント内容と照合する。
    match /sitterGrants/{code} {
      allow get: if request.auth != null;
      allow list: if false;
      allow create: if verified() &&
        request.auth.uid == request.resource.data.ownerUid &&
        request.resource.data.householdId is string &&
        request.resource.data.memberIds is list &&
        request.resource.data.expiresAt is timestamp &&
        request.resource.data.expiresAt > request.time;
      allow update: if false;
      allow delete: if request.auth != null &&
        request.auth.uid == resource.data.ownerUid;
    }

    // ─── Public pet cards （公開名刺ページ） ──────────────────────
    // 訪問者はリンク（cardId）を知っていれば get のみ可。列挙は禁止。
    // 作成・更新は確認済みユーザーが自分の ownerUid のカードだけ。削除は本人のみ。
    match /publicCards/{cardId} {
      allow get: if true;
      allow list: if false;
      allow create: if verified() &&
        request.auth.uid == request.resource.data.ownerUid;
      // 更新は既存ドキュメントの所有者だけ。新規データ側の ownerUid しか見ないと、
      // ownerUid を自分に書き換えた setDoc で他人の名刺を乗っ取れてしまうため、
      // resource（既存）側の所有者一致も必須にする。
      allow update: if verified() &&
        request.auth.uid == resource.data.ownerUid &&
        request.auth.uid == request.resource.data.ownerUid;
      allow delete: if request.auth != null &&
        request.auth.uid == resource.data.ownerUid;
    }

    // ─── Public health summaries （期限つき共有リンク） ─────────────
    // 病院サマリーを獣医・病院・預け先へ渡すための表示専用ドキュメント。
    // 名刺と違い医療寄りの情報のため、有効期限（expiresAt）を必須とし、
    // get は期限内のものだけ許可する（期限切れはサーバー側でも読めない）。
    // 作成は確認済みユーザーが自分の ownerUid のものだけ。内容の更新は不可
    // （直す場合は取り消して作り直す＝新規発行）。削除（取り消し）は所有者のみ。
    // 列挙は禁止（ID は推測困難な24文字ランダム）。
    match /publicSummaries/{sumId} {
      allow get: if resource.data.expiresAt is timestamp &&
        resource.data.expiresAt > request.time;
      allow list: if false;
      allow create: if verified() &&
        request.auth.uid == request.resource.data.ownerUid &&
        request.resource.data.expiresAt is timestamp;
      allow update: if false;
      allow delete: if request.auth != null &&
        request.auth.uid == resource.data.ownerUid;
    }

    // ─── Public lost-pet posters （迷子ポスター公開ページ） ──────────
    // 紙のポスターと同じ内容を表示専用で公開するドキュメント。連絡先を含むため
    // ID は推測困難な24文字ランダムにし、列挙は禁止する。
    // 作成・更新は確認済みユーザーが自分の ownerUid のものだけ（更新は既存
    // ドキュメントの所有者一致も必須＝乗っ取り防止、publicCards と同じ形）。
    // 削除（公開停止）は所有者のみ。内容は所有者がポスターを編集すると
    // アプリ側から自動で書き直される（捜索中の情報更新のため update を許可）。
    match /publicPosters/{posterId} {
      allow get: if true;
      allow list: if false;
      allow create: if verified() &&
        request.auth.uid == request.resource.data.ownerUid;
      allow update: if verified() &&
        request.auth.uid == resource.data.ownerUid &&
        request.auth.uid == request.resource.data.ownerUid;
      allow delete: if request.auth != null &&
        request.auth.uid == resource.data.ownerUid;
    }

    // ─── Households ───────────────────────────────────────────────
    match /households/{hid} {
      // Any member can read the household doc。有効期限内のシッターも世帯ドキュメント
      // 自体は読める（対象メンバー・権限・期限の表示に必要）。
      allow read: if request.auth != null &&
        (request.auth.uid in resource.data.memberUids || sitterActiveIn(resource.data));

      // 作成：確認済みユーザーが、自分を唯一のメンバーとして作る
      allow create: if verified() &&
        request.auth.uid == request.resource.data.ownerUid &&
        request.resource.data.memberUids == [request.auth.uid];

      // 更新：ownerUid / inviteCode は不変。その上で
      //   - オーナー（確認済み）：memberUids を自由に管理できる
      //   - 非オーナー（確認済み）：招待コードを証明した自分自身の追加（参加）のみ
      //   - 退出（自分の削除）：確認要件なしで常に許可（ロックアウト防止）
      allow update: if request.auth != null &&
        request.resource.data.ownerUid == resource.data.ownerUid &&
        request.resource.data.inviteCode == resource.data.inviteCode && (
          (verified() && request.auth.uid == resource.data.ownerUid) ||
          (verified() && isSelfJoin(resource, request)) ||
          isSelfLeave(resource, request)
        );

      // シッター参加（確認済み・グラント証明つき。memberUids は不変）。
      // 個別の allow 文に分ける：グラント文書が無い場合の get() エラーが、
      // 通常の参加・退出の判定へ波及しないようにするため。
      allow update: if verified() &&
        request.resource.data.ownerUid == resource.data.ownerUid &&
        request.resource.data.inviteCode == resource.data.inviteCode &&
        isSitterSelfJoin(hid, resource, request);

      // シッター退出（確認要件なし＝ロックアウト防止。通常退出と同じ扱い）。
      allow update: if request.auth != null &&
        request.resource.data.ownerUid == resource.data.ownerUid &&
        request.resource.data.inviteCode == resource.data.inviteCode &&
        isSitterSelfLeave(resource, request);

      // 参加者プロフィールの自己更新（自分の表示名エントリだけ・他は差分ゼロ）。
      allow update: if request.auth != null &&
        isProfileSelfUpdate(resource, request);

      // Only owner can delete
      allow delete: if request.auth != null &&
        request.auth.uid == resource.data.ownerUid;

      // ─── Family notes （家族ノートの世帯同期） ───────────────────
      // 「わたし」タブの家族ノートを世帯内で共有する実体。読み取りは世帯メンバーのみ
      // （シッターは対象外）。作成・更新は記録者本人、削除は本人または世帯オーナー。
      match /notes/{noteId} {
        allow read: if isMember(hid);
        allow create: if isMember(hid) &&
          request.auth.uid == request.resource.data.ownerUid;
        allow update: if isMember(hid) &&
          request.auth.uid == resource.data.ownerUid;
        allow delete: if isMember(hid) &&
          (request.auth.uid == resource.data.ownerUid ||
           request.auth.uid == householdOwnerUid(hid));
      }

      // ─── Household members ──────────────────────────────────────
      match /members/{memberId} {
        // 読み取りは resource.data で判定する。以前は memberVisible()（対象ドキュメントを
        // get() で引く形）だったが、コレクションのクエリではその条件を「証明」できず、
        // 誰に対しても丸ごと permission-denied になっていた（ルールはフィルタではない）。
        // クライアントは where("visibility","==","household") と
        // where("ownerUid","==",自分のuid) の2クエリに分けて取得し、それぞれ
        // 下記 OR の片方で証明できる。単一ドキュメント get の意味は従来と同一
        // （共有設定の子、または自分の子だけが読める。秘匿の範囲は変わらない）。
        allow read: if (isMember(hid) &&
          (resource.data.visibility == "household" || resource.data.ownerUid == request.auth.uid)) ||
          sitterCanSeeMember(hid, memberId);

        // Create: must be a household member and own the record
        // （シッターはメンバー自体を作れない）
        allow create: if isMember(hid) &&
          request.auth.uid == request.resource.data.ownerUid;

        // Update: only the owner of this member record
        allow update: if isMember(hid) &&
          request.auth.uid == resource.data.ownerUid;

        // Delete（破壊的操作）: メンバーを作った本人、または世帯オーナーのみ。
        // 共有した家族が他人のメンバーを間違えて消す事故を防ぐための権限分離
        // （2026-11-20 Kao決定：オーナーは全部可、作った本人は自分の分だけ可）。
        allow delete: if isMember(hid) &&
          (request.auth.uid == resource.data.ownerUid ||
           request.auth.uid == householdOwnerUid(hid));

        // ─── Member items ─────────────────────────────────────────
        match /items/{itemId} {
          // Readable if parent member is visible to current user。
          // シッターは対象メンバー配下だけ（期限・対象はルール側で強制）。
          allow read: if (isMember(hid) && memberVisible(hid, memberId)) ||
            sitterCanSeeMember(hid, memberId);

          // Create: must be a household member and own the item。
          // シッターは canWrite のときだけ、対象メンバー配下へ自分の ownerUid で作成可。
          // 既存アイテムの更新・削除はシッター不可（記録の追加だけ）。
          allow create: if (isMember(hid) &&
            request.auth.uid == request.resource.data.ownerUid) ||
            (sitterCanSeeMember(hid, memberId) && sitterCanWrite(hid) &&
             request.auth.uid == request.resource.data.ownerUid);

          // Update: only the owner
          allow update: if isMember(hid) &&
            request.auth.uid == resource.data.ownerUid;

          // Delete: 記録を作った本人に加え、メンバー削除に伴う一括削除（バッチ）を
          // 通すため、世帯オーナーと、そのメンバーを作った本人も許可する。
          // （メンバー自体は消せるのに、他人が記録した配下のアイテムでバッチ全体が
          // 失敗して削除できない、という不整合を避けるための付随変更。作成・更新は不変。）
          allow delete: if isMember(hid) &&
            (request.auth.uid == resource.data.ownerUid ||
             request.auth.uid == householdOwnerUid(hid) ||
             request.auth.uid == get(/databases/$(database)/documents/households/$(hid)/members/$(memberId)).data.ownerUid);
        }

        // ─── Member photos（共有写真） ────────────────────────────
        // 写真1枚＝1ドキュメント。data に共有コピー（480px JPEG の data URL 文字列）を
        // 持つ。読み取りは items と同じ memberVisible 判定（memberId はパスで固定の
        // ため、photos のコレクションクエリでも証明できる）。
        // 作成はアップロード本人が自分の ownerUid を刻んだ場合のみ。更新は既存
        // ドキュメントの所有者本人だけ（publicCards と同じ乗っ取り対策：新規データ側の
        // ownerUid だけを見ると、他人の写真を自分の ownerUid で上書きできてしまう）。
        // サイズ上限は巨大ドキュメントの混入防止（共有コピーは通常 200KB 未満）。
        // 削除は items と同じ3者（アップロード本人・世帯オーナー・メンバー作成者）で、
        // 記録削除・メンバー削除に伴う後始末を通す。
        match /photos/{photoId} {
          allow read: if (isMember(hid) && memberVisible(hid, memberId)) ||
            sitterCanSeeMember(hid, memberId);
          allow create: if (isMember(hid) &&
            request.auth.uid == request.resource.data.ownerUid &&
            request.resource.data.data is string &&
            request.resource.data.data.size() <= 700000) ||
            (sitterCanSeeMember(hid, memberId) && sitterCanWrite(hid) &&
             request.auth.uid == request.resource.data.ownerUid &&
             request.resource.data.data is string &&
             request.resource.data.data.size() <= 700000);
          allow update: if isMember(hid) &&
            request.auth.uid == resource.data.ownerUid &&
            request.auth.uid == request.resource.data.ownerUid &&
            request.resource.data.data is string &&
            request.resource.data.data.size() <= 700000;
          allow delete: if isMember(hid) &&
            (request.auth.uid == resource.data.ownerUid ||
             request.auth.uid == householdOwnerUid(hid) ||
             request.auth.uid == get(/databases/$(database)/documents/households/$(hid)/members/$(memberId)).data.ownerUid);
        }
      }
    }
  }
}
