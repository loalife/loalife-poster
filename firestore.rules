rules_version = '2';

// ============================================================================
// データ永続性ルール（生活インフラ）— 編集時の必読事項
//  - フィールドを厳格に検証する hasOnly() 等は安易に足さないこと。
//    新旧バージョンのドキュメントが混在するため、未知フィールド（version 含む）を
//    拒否すると、アップデート直後の既存ユーザーの書き込みが壊れる。
//  - 破壊的なルール変更（既存データの読み取り/更新を不能にする変更）は禁止。
//    スキーマ移行はアプリ側の schema.js（lazy migration）で吸収する方針。
//
//  セキュリティ不変条件（2026 監査対応・非破壊で追加）:
//   1. households の ownerUid / inviteCode は作成後に変更不可（乗っ取り・コード差し替え防止）。
//   2. 非オーナーは memberUids を「自分の uid の追加（参加）/削除（退出）」のみ変更可能。
//      他メンバーの追加・削除はオーナーのみ（締め出し防止）。
//   3. 参加（自分の追加）は招待コードの知識を証明（joinProof == inviteCode）した場合のみ。
//      → household ID を推測しても、コードを知らなければ参加できない（BOLA 防止）。
//   4. inviteCodes は list（列挙）禁止・get のみ許可（コード総なめ防止）。
//   5. 家族の新規作成・参加・招待コード作成はメール確認済み（または Google）ユーザーのみ。
//      ※ 退出と、既存メンバーによる自分のデータ更新は従来どおり（ロックアウト防止）。
//  変更時は Firebase エミュレータで「作成→参加→退出」と既存データ更新の回帰を必ず確認すること。
// ============================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // メール確認済み、または Google ログイン（Google は常に確認済み扱い）
    function verified() {
      return request.auth != null && (
        request.auth.token.email_verified == true ||
        request.auth.token.firebase.sign_in_provider == 'google.com'
      );
    }

    // Helper: check if user is in a household
    function isMember(hid) {
      return request.auth != null &&
        request.auth.uid in get(/databases/$(database)/documents/households/$(hid)).data.memberUids;
    }

    // Helper: check if member is visible to current user
    function memberVisible(hid, memberId) {
      let m = get(/databases/$(database)/documents/households/$(hid)/members/$(memberId)).data;
      return m.visibility == "household" || m.ownerUid == request.auth.uid;
    }

    // 参加：自分の uid を1つだけ追加し、他メンバーは不変。招待コードの知識を証明すること。
    function isSelfJoin(before, req) {
      return !(req.auth.uid in before.data.memberUids)
        && (req.auth.uid in req.resource.data.memberUids)
        && req.resource.data.memberUids.hasAll(before.data.memberUids)
        && req.resource.data.memberUids.size() == before.data.memberUids.size() + 1
        && req.resource.data.joinProof == before.data.inviteCode;
    }

    // 退出：自分の uid を1つだけ削除し、他メンバーは不変。
    function isSelfLeave(before, req) {
      return (req.auth.uid in before.data.memberUids)
        && !(req.auth.uid in req.resource.data.memberUids)
        && before.data.memberUids.hasAll(req.resource.data.memberUids)
        && req.resource.data.memberUids.size() == before.data.memberUids.size() - 1;
    }

    // ─── User profiles ───────────────────────────────────────────
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      // "Me" items — always private, only owner can access
      match /meItems/{itemId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // ─── Invite codes (lookup table for joining) ──────────────────
    match /inviteCodes/{code} {
      // get のみ（参加時のコード→household 解決）。list（列挙）は禁止。
      allow get: if request.auth != null;
      allow list: if false;
      // 作成は確認済みユーザーのみ（householdId を含むこと）。
      allow create: if verified() &&
        request.resource.data.householdId is string;
      // 更新/削除はクライアントから不可（将来の失効はサーバー側で）。
      allow update, delete: if false;
    }

    // ─── Households ───────────────────────────────────────────────
    match /households/{hid} {
      // Any member can read the household doc
      allow read: if request.auth != null &&
        request.auth.uid in resource.data.memberUids;

      // 作成：確認済みユーザーが、自分を唯一のメンバーとして作る
      allow create: if verified() &&
        request.auth.uid == request.resource.data.ownerUid &&
        request.resource.data.memberUids == [request.auth.uid];

      // 更新：ownerUid / inviteCode は不変。その上で
      //   - オーナー（確認済み）：memberUids を自由に管理できる
      //   - 非オーナー（確認済み）：招待コードを証明した自分自身の追加（参加）のみ
      //   - 退出（自分の削除）：確認要件なしで常に許可（ロックアウト防止）
      allow update: if request.auth != null &&
        request.resource.data.ownerUid == resource.data.ownerUid &&
        request.resource.data.inviteCode == resource.data.inviteCode && (
          (verified() && request.auth.uid == resource.data.ownerUid) ||
          (verified() && isSelfJoin(resource, request)) ||
          isSelfLeave(resource, request)
        );

      // Only owner can delete
      allow delete: if request.auth != null &&
        request.auth.uid == resource.data.ownerUid;

      // ─── Household members ──────────────────────────────────────
      match /members/{memberId} {
        // Visible if: household visibility OR the owner is querying
        allow read: if isMember(hid) && memberVisible(hid, memberId);

        // Create: must be a household member and own the record
        allow create: if isMember(hid) &&
          request.auth.uid == request.resource.data.ownerUid;

        // Update/delete: only the owner of this member record
        allow update, delete: if isMember(hid) &&
          request.auth.uid == resource.data.ownerUid;

        // ─── Member items ─────────────────────────────────────────
        match /items/{itemId} {
          // Readable if parent member is visible to current user
          allow read: if isMember(hid) && memberVisible(hid, memberId);

          // Create: must be a household member and own the item
          allow create: if isMember(hid) &&
            request.auth.uid == request.resource.data.ownerUid;

          // Update/delete: only the owner
          allow update, delete: if isMember(hid) &&
            request.auth.uid == resource.data.ownerUid;
        }
      }
    }
  }
}
